# OpenClaw Configuration
NODE_ENV=production
PORT=3001

# Discord Bot
DISCORD_ENABLED=true
DISCORD_BOT_TOKEN=your-discord-bot-token
DISCORD_CHANNEL_ID=your-channel-id
DISCORD_SUMMARY_CHANNEL_ID=your-summary-channel-id
DISCORD_GUILD_ID=your-guild-id
AUTO_SETUP_CHANNELS=false
AUTO_BUILD_ROADMAP=false

# OpenAI
OPENAI_API_KEY=your-openai-api-key
OPENAI_MODEL=gpt-4.1-mini
DEFAULT_MAX_TOKENS=1024

# Cost Limits
DAILY_BUDGET_USD=1.50
MONTHLY_BUDGET_USD=45.00
ALERT_THRESHOLD_PCT=80

# Approval Gates
REQUIRE_APPROVAL_FOR_DEPLOY=true
REQUIRE_APPROVAL_FOR_EXTERNAL_COMMS=true
REQUIRE_APPROVAL_OVER_USD=0.50

# GitHub (optional for autonomous deployments)
GITHUB_TOKEN=
GITHUB_REPO=

# Logging
LOG_LEVEL=info

# Timezone
DEFAULT_TZ=America/New_York

# Email (Daily report at 6 AM)
ADMIN_EMAIL=admin@shieldtechsolutions.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=

# Token optimization
DYNAMIC_MAX_TOKENS=
KB_CONTEXT_LIMIT=

# Knowledge Base
KB_PATH=/absolute/path/to/knowledge-base/shieldtech
ROADMAP_PATH=/absolute/path/to/project_roadmap.md

# Password Vault (Google Sheets)
PASSWORDS_SHEET_ID=your-sheet-id
PASSWORDS_SHEET_NAME=Passwords

# Google Drive Backups
BACKUP_DRIVE_FOLDER_ID=your-drive-folder-id
BACKUP_PATHS_AUTO=/home/shieldtech/openclaw-builds
BACKUP_PATHS_CORE=/home/shieldtech/openclaw-builds
BACKUP_PATHS_CLOUD=/home/kosmox_ai/openclaw

# SSH Defense
SSH_DEFENSE_REMOTE=false
SSH_DEFENSE_LOCAL_TAILSCALE=false
TAILSCALE_CIDR=100.64.0.0/10

# Google OAuth / Service Account
GOOGLE_CLIENT_ID=your-client-id
GOOGLE_CLIENT_SECRET=your-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/oauth/callback
GOOGLE_REFRESH_TOKEN=your-refresh-token
GOOGLE_SERVICE_ACCOUNT_PATH=/absolute/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=

# Pi SSH Configuration (optional if you deploy)
PI_SSH_KEY_PATH=/path/to/private/key
PI4_CORE_HOST=
PI4_CORE_USER=
PI4_CORE_PATH=
PI4_AUTO_HOST=
PI4_AUTO_USER=
PI4_AUTO_PATH=

# Cloud VM (optional)
ORACLE_HOST=
ORACLE_USER=
ORACLE_PATH=
